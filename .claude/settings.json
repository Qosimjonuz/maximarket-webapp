{
  "enabledPlugins": {
    "ecc@ecc": true,
    "lemo-opuscar@lemolab": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    },
    "lemolab": {
      "source": {
        "source": "github",
        "repo": "lemomo-ai/lemo-opuscar"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(python3.13 -m pip install edge-tts)",
      "Bash(sh */lemo-opuscar/scripts/setup.sh*)"
    ]
  }
}
